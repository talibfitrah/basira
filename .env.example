# ===== إعدادات بصيرة الأساسية =====
# الرابط العام للمنصة (بلا شرطة في آخره) — مهم للدفع وروابط Stripe
PUBLIC_URL=https://ai.murabbie.org

# سرّ التشفير (٣٢ حرفًا عشوائيًّا على الأقل). أنشئه مرة واحدة ولا تغيّره بعد ذلك.
APP_SECRET=ضع_هنا_نصا_عشوائيا_طويلا

# سرّ محرك البحث المحلي (أي نص عشوائي طويل)
SEARXNG_SECRET=ضع_هنا_نصا_عشوائيا_اخر

# بريد المشرف: أول من يسجَّل يصير مشرفًا تلقائيًّا، وهذا البريد أيضًا
ADMIN_EMAIL=
APP_NAME=بَصِيرة
SUPPORT_EMAIL=

# ===== الاستقلال التام =====
# 1 = لا اتصال بأي شركة ذكاء اصطناعي؛ كل النماذج على هذا الجهاز (الافتراضي)
INDEPENDENT_MODE=1

# ===== الدفع (يمكن ضبطه من لوحة الإدارة) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== المكتبة الشرعية =====
# إن ربطت مجلد الشاملة في docker-compose فاكتب مساره داخل الحاوية:
# SHAMELA_DIR=/shamela
# وإلا تُجلب الكتب من روابط NAS العامة:
SHAMELA_MANIFEST_URL=https://files.murabbie.org/fsdownload/FnGtHqpG9/manifest.json

# نموذج تفريغ الصوت (الأصغر أسرع، والأكبر أدق للعربية):
# Systran/faster-whisper-small  أو  Systran/faster-whisper-medium
WHISPER_MODEL=Systran/faster-whisper-small

# وضع العرض (نموذج تجريبي ثابت الرد) — اتركه 0
DEMO_MODE=0

# ===== تراخيص برنامج سطح المكتب =====
# المفتاح الخاص لتوقيع التراخيص (من ملف الأسرار المسلَّم). لا تنشره ولا تغيّره:
# البرنامج المنزَّل يحمل المفتاح العام المقابل له، فإن تغيّر بطلت التراخيص كلها.
LICENSE_PRIVATE_KEY=

# روابط تنزيل البرنامج (تظهر للمشتركين في صفحة حسابهم؛ ويمكن تغييرها من لوحة الإدارة)
DESKTOP_WIN_URL=
DESKTOP_MAC_URL=
DESKTOP_MACINTEL_URL=
DESKTOP_LINUX_URL=
