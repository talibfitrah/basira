{
  "name": "basira-desktop",
  "productName": "Basira",
  "version": "1.0.0",
  "description": "بصيرة — مساعد ذكاء اصطناعي يعمل بلا إنترنت، مع مكتبة شرعية موثقة",
  "author": "Stichting Tarbiyah",
  "main": "main.cjs",
  "private": true,
  "build": {
    "appId": "org.murabbie.basira",
    "productName": "Basira",
    "copyright": "Stichting Tarbiyah",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "Basira-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "بصيرة",
      "uninstallDisplayName": "بصيرة",
      "artifactName": "Basira-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "Basira-${version}-mac-${arch}.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "Basira-${version}-linux-x64.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://ai.murabbie.org/downloads"
      }
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "afterPack": "./afterPack.cjs"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "pe-library": "^2.0.1",
    "resedit": "^2.0.3"
  }
}